{
  "expo": {
    "name": "Aşçım Gelsin",
    "slug": "ascim-gelsin",
    "scheme": "ascimgelsin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#160606",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#160606"
    },
    "ios": {
      "bundleIdentifier": "com.ascimgelsin.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ascimgelsin.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#160606",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Aşçı profilinde yemek fotoğraflarını göstermek için galerine erişmemiz gerekiyor.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A30909"
        }
      ]
    ]
  }
}
