rules_version = '2';

// Nonna fiyat yönetimi için Firestore kuralları.
// Firebase konsolu → Firestore Database → Rules sekmesine yapıştırın,
// ADMIN_UID yerine Authentication → Users listesindeki admin hesabının "User UID" değerini yazın.
service cloud.firestore {
  match /databases/{database}/documents {

    // Sitedeki canlı fiyatlar: herkes okuyabilir, yalnızca admin yazabilir.
    match /site/menu {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "ADMIN_UID"
        && request.resource.data.keys().hasOnly(["prices", "updatedAt", "updatedBy"])
        && request.resource.data.prices is map;
    }

    // Başka hiçbir belgeye erişim yok.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
