# Claude API anahtarı (https://console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Randevu panelinin şifresi (/admin). Boş bırakılırsa panel kapalıdır.
ADMIN_PASSWORD=

# İsteğe bağlı ayarlar
# PORT=3000
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
